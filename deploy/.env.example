# 复制为 .env 并填写真实值：cp .env.example .env
# 本模板对应的是**同一个目录下的 deploy/docker-compose.yml**（服务器上为 /opt/habitforge/deploy），
# 变量名以那份 compose 的 ${...} 为准。与仓库根目录的 docker-compose.yml（本机开发用，自带
# mysql/redis 容器、用 MYSQL_ROOT_PASSWORD）变量名**不同**，别照抄混淆。

# ── 必填（缺失时 compose 直接拒绝启动并提示变量名）──────────────────────────

# JWT 签名密钥（强随机值，泄露 = 任何人可伪造登录态；更换会使所有已登录用户 token 失效）
# 生成方法：openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

# 服务器原生 MySQL 的密码。compose 里做的是 ${MYSQL_PASSWORD:?}，名字必须是 MYSQL_PASSWORD。
# 注意：不是 MYSQL_ROOT_PASSWORD —— 那个是仓库根目录那份 compose（自带 MySQL 容器）用的。
# 用户名另行通过 MYSQL_USER 覆盖，默认 root。
MYSQL_PASSWORD=REPLACE_WITH_REAL_MYSQL_PASSWORD
# MYSQL_USER=root

# CORS 允许的来源（逗号分隔）。compose 里是 ${APP_CORS_ALLOWED_ORIGIN_PATTERNS:?}，必填。
# 生产只放行精确来源；换域名/端口访问时必须同步改这里，否则浏览器 POST 会被 CORS 拒绝。
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://REPLACE_WITH_SERVER_IP:8081

# MinIO 对象存储（日记/笔记图片）的密钥
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY

# ── 选填（compose 里已给默认值，通常不用写）────────────────────────────────

# MinIO 地址与 access key，默认 http://host.docker.internal:9000 / minioadmin
# MINIO_ENDPOINT=http://host.docker.internal:9000
# MINIO_ACCESS_KEY=minioadmin

# AI 今日安排的密钥（DeepSeek，https://platform.deepseek.com 申请）。
# 只填在这里，严禁写进代码/配置/提交。
# 故意留空而不是填占位符：占位符是非空字符串，会被当成"已配置"发出去撞 401，
# 表现为 6004「AI 服务调用失败」；留空则明确表现为 6001「AI 服务未启用」。
AI_API_KEY=

# AI 总开关（默认 true）。设 false 可紧急关闭 AI 而不影响其它功能，此时上面不填也行。
# AI_ENABLED=false

# 换供应商/换模型时的覆盖项（默认见 application.yml）。
# 这两项 compose 已转发，填在 .env 里即生效。
# AI_BASE_URL=https://api.deepseek.com/anthropic
# AI_MODEL=deepseek-v4-flash
