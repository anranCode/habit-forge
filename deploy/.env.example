# 复制为 .env 并填写真实值：cp .env.example .env

# 必填：JWT 签名密钥（强随机值，泄露会导致 token 可被伪造）
# 生成方法: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

# 服务器原生 MySQL 的账号密码
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_WITH_REAL_PASSWORD

# 选填:CORS 允许的来源模式(逗号分隔)。默认只放行 http://<你的服务器IP>:8081。
# 若以后换域名/端口访问,在此追加,如:https://www.example.com,http://<你的服务器IP>:9000
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://<你的服务器IP>:8081
